// Copy this file to Config/Local.xcconfig (it is git-ignored) and set your own values.
// Your Team ID: Xcode → Settings → Accounts → select your Apple ID → Team (a 10-character code).
// A free Apple ID works; the app must then be re-installed from Xcode every 7 days.

BUNDLE_ID_PREFIX = com.yourname
DEVELOPMENT_TEAM = ABCDE12345
